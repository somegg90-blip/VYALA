# VYALA backend configuration — copy to .env and fill in real values.
# NEVER commit the real .env file.

# Postgres connection string (Supabase pooler URL works too)
DATABASE_URL="postgres://postgres:password@localhost:5432/vyala?sslmode=disable"
PORT=8080

# GitHub OAuth App credentials (https://github.com/settings/developers)
GITHUB_CLIENT_ID="your-github-oauth-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-client-secret"

# Must match the callback URL registered on the GitHub OAuth App
OAUTH_REDIRECT_URL="http://localhost:8080/auth/github/callback"

# Session signing secret — REQUIRED, at least 32 random characters.
# Generate with: openssl rand -hex 32
SESSION_SECRET="replace-with-32+-random-characters"

# Frontend origin for CORS + post-login redirect
FRONTEND_URL="http://localhost:5173"

# Shared key the vyala CLI uses for POST /v1/scans uploads
CLI_API_KEY="replace-with-a-long-random-string"

ENV="development"
