# Build stage
FROM golang:1.21-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o vyala-server ./cmd/server/

# Run stage
FROM alpine:latest
WORKDIR /app
COPY --from=builder /app/vyala-server .
EXPOSE 8080
CMD ["./vyala-server"]